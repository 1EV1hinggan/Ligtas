<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ligtas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- HEADER, greeting and section titles: Jetpack Compose (see AdminHeader.kt) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- EMERGENCY TYPES + ALERT EVERYONE + STATUS/EDIT: Jetpack Compose (see EmergencyPanel.kt).
             The old XML version is still in activity_admin_dashboard.xml as a fallback. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- Status and Edit pills are inside the Compose panel above -->
    </LinearLayout>
    </ScrollView>

    <!-- CONFIRM: slide to send. Drawn by Compose (SlideToSend.kt); Java shows it when Alert everyone is tapped.
         The old XML card is still in activity_admin_dashboard.xml as a fallback. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeConfirm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
